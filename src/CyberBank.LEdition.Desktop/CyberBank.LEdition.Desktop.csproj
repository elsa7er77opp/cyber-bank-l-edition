  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CyberBank.LEdition/CyberBank.LEdition.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>
